#!/usr/bin/env python3
"""Executable shim for the halo-rlm CLI.

Usage: ./halo-rlm TRACES.jsonl -p "Diagnose errors" [--mock-demo] [...]
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from halo_rlm.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
